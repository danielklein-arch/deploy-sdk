{
  "name": "@danielklein/deploy-sdk",
  "version": "0.10.0",
  "type": "module",
  "description": "Wrangler-only Cloudflare Workers deploy engine + CLI — per-PR previews + stable envs (dev/staging/prod). Bun-only.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "deploy-sdk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts ./src/cli.ts --outdir dist --target bun && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "bun run build"
  },
  "peerDependencies": {
    "wrangler": ">=4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.6.0",
    "wrangler": "4.98.0"
  }
}
